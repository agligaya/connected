PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=connected_system
JWT_SECRET=connected_secret_key_2026_change_this_later

# --- SMS (iTexMo API v5 by default) ---
# Docs: POST https://api.itexmo.com/api/broadcast
# Needs: ITEXMO_EMAIL + ITEXMO_PASSWORD + SMS_API_KEY (ApiCode)
# Optional: SMS_SENDER = SenderId (if your package has a registered brand)
#
# SMS_PROVIDER=itexmo | semaphore
# Keep SMS_DRY_RUN=true until credentials work.
SMS_PROVIDER=itexmo
SMS_API_KEY=
ITEXMO_EMAIL=
ITEXMO_PASSWORD=
SMS_SENDER=
SMS_DRY_RUN=true
SMS_POLL_MS=60000
SMS_MAX_ATTEMPTS=5

# --- AI lesson recommendations ---
# Mock drafts work without a key. For live OpenAI: set key and AI_DRY_RUN=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DRY_RUN=true
