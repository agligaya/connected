PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=connected_system
JWT_SECRET=connected_secret_key_2026_change_this_later

# --- SMS (iTexMo API v5 by default) ---
# Docs: POST https://api.itexmo.com/api/broadcast
# Needs: ITEXMO_EMAIL + ITEXMO_PASSWORD + SMS_API_KEY (ApiCode)
# Optional: SMS_SENDER = SenderId (if your package has a registered brand)
#
# SMS_PROVIDER=itexmo | semaphore
# Keep SMS_DRY_RUN=true until credentials work.
SMS_PROVIDER=itexmo
SMS_API_KEY=
ITEXMO_EMAIL=
ITEXMO_PASSWORD=
SMS_SENDER=
SMS_DRY_RUN=true
SMS_POLL_MS=60000
SMS_MAX_ATTEMPTS=5

# --- AI lesson recommendations ---
# Mock drafts work with AI_DRY_RUN=true.
#
# Local Ollama (free) — install Ollama, run: ollama pull llama3.2
# Then set:
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.2
#   AI_DRY_RUN=false
#
# Or paid OpenAI: OPENAI_API_KEY=sk-... and AI_DRY_RUN=false
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2
AI_DRY_RUN=false
