# --- AI lesson recommendations ---
# Mock drafts work with AI_DRY_RUN=true.
#
# Local Ollama (free) — install Ollama, run: ollama pull llama3.2
# Then set:
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.2
#   AI_DRY_RUN=false
#
# Or paid OpenAI: OPENAI_API_KEY=sk-... and AI_DRY_RUN=false
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2
AI_DRY_RUN=false
