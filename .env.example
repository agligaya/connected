PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=connected_system
JWT_SECRET=change_me

# iTexMo API v5 (default) or semaphore
SMS_PROVIDER=itexmo
SMS_API_KEY=
ITEXMO_EMAIL=
ITEXMO_PASSWORD=
SMS_SENDER=
SMS_DRY_RUN=true
SMS_POLL_MS=60000
SMS_MAX_ATTEMPTS=5

# --- AI lesson recommendations ---
# Mock drafts: leave AI_DRY_RUN=true (or omit key / local URL).
#
# Option A — local Ollama (free):
#   1. Install Ollama, then: ollama pull llama3.2
#   2. Set the three lines below and AI_DRY_RUN=false
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
# AI_DRY_RUN=false
#
# Option B — paid OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_DRY_RUN=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DRY_RUN=true
